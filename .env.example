# All optional. Missing values degrade gracefully instead of erroring:
#   no Redis    -> in-memory room store (dev only, lost on restart)
#   no Gemini   -> canned verdict, flow stays demonstrable
#   no Places   -> skip the existence check, fall back to the Maps search link
#   no Supabase -> default settings, no history recorded
#   no password -> /admin refuses to open at all

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rooms: hot, ephemeral, 24h TTL, polled every 2s. Also backs rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Places API key. Only ever used with a `places.id` field mask
# (Text Search Essentials IDs-Only: unlimited, free). Never request a
# name-bearing field -- that bills at Pro, $32/1k. See docs/plans.
GOOGLE_PLACES_API_KEY=

# Supabase: durable admin storage (tunable settings + case history).
# Service role key, server-only. Run supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gate for /admin. Unset means the panel is locked shut, not wide open.
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=
