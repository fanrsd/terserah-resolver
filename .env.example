# Supabase is the only hard dependency. Everything else degrades gracefully:
#   no LLM key  -> canned fallback verdict, the flow still demonstrates
#   no Places   -> skip the existence check, the Maps search link still works
#   no password -> /admin refuses to open at all

# --- Store (required) --------------------------------------------------------
# Rooms, case history, and settings all live here. Service role key,
# server-only. Run supabase/schema.sql once, then the files in migrations/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Judge -------------------------------------------------------------------
# Provider, model, temperature and base URL are set in /admin/pengaturan.
# Only keys live here.

# Used when the provider is "Gemini langsung".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback key for a custom OpenAI-compatible endpoint, used when no key has
# been saved in the admin panel. OPENAI_API_KEY is also accepted.
LLM_API_KEY=

# Lets the admin panel store a custom endpoint's key in Supabase, encrypted
# with AES-GCM. Any string >= 16 chars. Without it that field is disabled and
# the key must come from LLM_API_KEY above -- nothing is ever stored in clear.
SETTINGS_ENCRYPTION_KEY=

# --- Misc --------------------------------------------------------------------

# Gate for /admin. Unset means the panel is locked shut, not wide open.
ADMIN_PASSWORD=

# Only needed locally; production uses the domain in lib/site.ts.
NEXT_PUBLIC_SITE_URL=
