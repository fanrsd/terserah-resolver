# All optional. Missing values degrade gracefully instead of erroring:
#   no LLM key  -> canned fallback verdict, flow stays demonstrable
#   no Redis    -> in-memory room store (dev only, lost on restart)
#   no Places   -> skip the existence check, fall back to the Maps search link
#   no Supabase -> default settings, no history recorded
#   no password -> /admin refuses to open at all

# --- Judge -------------------------------------------------------------------
# Provider, model, temperature, and base URL are set in /admin/pengaturan.
# Only the keys live here.

# Used when the provider is "Gemini langsung".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback key for a custom OpenAI-compatible endpoint, used when no key has
# been saved in the admin panel. OPENAI_API_KEY is also accepted.
LLM_API_KEY=

# Lets the admin panel store a custom endpoint's key in Supabase, encrypted
# with AES-GCM. Any string >= 16 chars. Without it that field is disabled and
# the key must come from LLM_API_KEY above — nothing is ever stored in clear.
SETTINGS_ENCRYPTION_KEY=

# --- Stores ------------------------------------------------------------------
# Rooms: hot, ephemeral, 24h TTL, polled every 2s. Also backs rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase: durable admin storage (tunable settings + case history).
# Service role key, server-only. Run supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Misc --------------------------------------------------------------------
# Places API key. Only ever used with a `places.id` field mask
# (Text Search Essentials IDs-Only: unlimited, free). Never request a
# name-bearing field -- that bills at Pro, $32/1k. See docs/plans.
GOOGLE_PLACES_API_KEY=

# Gate for /admin. Unset means the panel is locked shut, not wide open.
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=
